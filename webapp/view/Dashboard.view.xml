<mvc:View
    controllerName="employeemanagement.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="dashboardPage"
        showHeader="false">

        <content>

            <VBox id="_IDGenVBox1" class="sapUiLargeMargin">

                <!-- WELCOME SECTION -->
                <HBox id="_IDGenHBox"
                    width="100%"
                    justifyContent="SpaceBetween"
                    alignItems="Center">

                    <!-- LEFT -->
                    <VBox id="_IDGenVBox2">

                        <Title id="_IDGenTitle2"
                            text="{dashboard>/greeting}"
                            level="H1"/>

                        <Text id="_IDGenText15"
                            text="Welcome back to Employee Management"
                            class="sapUiTinyMarginTop"/>

                        <HBox id="_IDGenHBox1" class="sapUiMediumMarginTop">

                            <ObjectStatus id="_IDGenObjectStatus"
                                icon="sap-icon://calendar"
                                text="{dashboard>/date}"/>

                            <ObjectStatus id="_IDGenObjectStatus1"
                                icon="sap-icon://history"
                                text="{dashboard>/time}"
                                class="sapUiMediumMarginBegin"/>

                        </HBox>

                    </VBox>


                    <!-- RIGHT IMAGE -->
                    <Image id="_IDGenImage"
                        src="./images/dashboard.png"
                        width="300px"
                        decorative="true"/>

                </HBox>


                <!-- QUICK ACTIONS -->

                <Title id="_IDGenTitle3"
                    text="Quick Actions"
                    level="H2"
                    class="sapUiLargeMarginTop sapUiSmallMarginBottom"/>

                <HBox id="_IDGenHBox2"
                    wrap="Wrap">

                    <GenericTile id="_IDGenGenericTile"
                        header="Add Employee"
                        subheader="Create employee"
                        press=".onAddEmployee"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">

                        <TileContent id="_IDGenTileContent">
                            <ImageContent id="_IDGenImageContent"
                                src="sap-icon://add-employee"/>
                        </TileContent>

                    </GenericTile>


                    <GenericTile id="_IDGenGenericTile1"
                        header="Employees"
                        subheader="View directory"
                        press=".onEmployeesPress"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">

                        <TileContent id="_IDGenTileContent1">
                            <ImageContent id="_IDGenImageContent1"
                                src="sap-icon://employee"/>
                        </TileContent>

                    </GenericTile>


                    <GenericTile id="_IDGenGenericTile2"
                        header="Search Employee"
                        subheader="Find employee"
                        press=".onEmployeesPress"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">

                        <TileContent id="_IDGenTileContent2">
                            <ImageContent id="_IDGenImageContent2"
                                src="sap-icon://search"/>
                        </TileContent>

                    </GenericTile>

                </HBox>


                <!-- RECENT EMPLOYEES -->

                <Title id="_IDGenTitle4"
                    text="Recent Employees"
                    level="H2"
                    class="sapUiLargeMarginTop sapUiSmallMarginBottom"/>

                <Table id="_IDGenTable"
                    items="{
                        path: '/Employees',
                        sorter: {
                            path: 'HireDate',
                            descending: true
                        }
                    }">

                    <columns>

                        <Column id="_IDGenColumn8">
                            <Text id="_IDGenText16" text="Employee"/>
                        </Column>

                        <Column id="_IDGenColumn9">
                            <Text id="_IDGenText17" text="Job Title"/>
                        </Column>

                        <Column id="_IDGenColumn10">
                            <Text id="_IDGenText18" text="Hire Date"/>
                        </Column>

                    </columns>

                    <items>

                        <ColumnListItem id="_IDGenColumnListItem1">

                            <cells>

                                <ObjectIdentifier id="_IDGenObjectIdentifier1"
                                    title="{FirstName} {LastName}"
                                    text="{EmployeeID}"/>

                                <Text id="_IDGenText19" text="{Title}"/>

                                <Text id="_IDGenText20"
                                    text="{
                                        path: 'HireDate',
                                        type: 'sap.ui.model.type.Date',
                                        formatOptions: {
                                            style: 'medium'
                                        }
                                    }"/>

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </content>

    </Page>

</mvc:View>