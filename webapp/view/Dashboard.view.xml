<mvc:View
    controllerName="employeemanagement.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    
    xmlns="sap.m">

    <Page
        id="dashboardPage"
        showHeader="false"
        class="dashboardPage">

        <content>

            <VBox
                id="_IDGenVBox"
                class="dashboardContainer">

                <!-- WELCOME BANNER -->
                <HBox
                    id="welcomeBanner"
                    width="100%"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    class="welcomeBanner">

                    <!-- LEFT SIDE -->
                    <VBox
                        id="welcomeContent"
                        width="55%"
                        class="welcomeContent">

                        <Title
                            id="_IDGenTitle2"
                            text="{dashboard>/greeting}"
                            level="H1"
                            class="greetingTitle"/>

                        <Text
                            id="_IDGenText15"
                            text="Welcome back to Employee Management"
                            class="welcomeText"/>

                        <!-- DATE AND TIME -->
                        <HBox
                            id="dateTimeContainer"
                            alignItems="Center"
                            wrap="Wrap"
                            class="dateTimeContainer">

                            <HBox id="_IDGenHBox1"
                                alignItems="Center"
                                class="dateContainer">

                                <core:Icon id="_IDGenIcon"
                                    xmlns:core="sap.ui.core"
                                    src="sap-icon://calendar"
                                    class="dashboardIcon"/>

                                <Text id="_IDGenText16"
                                    text="{dashboard>/date}"
                                    class="dashboardDate"/>

                            </HBox>

                            <HBox id="_IDGenHBox3"
                                alignItems="Center"
                                class="timeContainer">

                                <core:Icon id="_IDGenIcon1"
                                    xmlns:core="sap.ui.core"
                                    src="sap-icon://history"
                                    class="dashboardIcon"/>

                                <Text id="_IDGenText17"
                                    text="{dashboard>/time}"
                                    class="dashboardTime"/>

                            </HBox>

                        </HBox>

                    </VBox>


                    <!-- RIGHT SIDE IMAGE -->
                    <VBox
                        id="imageContainer"
                        width="45%"
                        alignItems="End"
                        justifyContent="Center"
                        class="dashboardImageContainer">

                        <Image
                            id="_IDGenImage"
                            src="images/dashboard-bg.webp"
                            decorative="true"
                            class="dashboardImage"/>

                    </VBox>

                </HBox>


                <!-- QUICK ACTIONS SECTION -->
                <VBox id="_IDGenVBox1" class="dashboardSection">

                    <Title
                        id="_IDGenTitle3"
                        text="Quick Actions"
                        level="H2"
                        class="sectionTitle"/>

                    <HBox
                        id="_IDGenHBox2"
                        wrap="Wrap"
                        class="quickActions">

                        <GenericTile
                            id="_IDGenGenericTile"
                            header="Add Employee"
                            subheader="Create employee"
                            press=".onAddEmployee"
                            class="actionTile">

                            <TileContent id="_IDGenTileContent">
                                <ImageContent id="_IDGenImageContent"
                                    src="sap-icon://add-employee"/>
                            </TileContent>

                        </GenericTile>


                        <GenericTile
                            id="_IDGenGenericTile1"
                            header="Employees"
                            subheader="View directory"
                            press=".onEmployeesPress"
                            class="actionTile">

                            <TileContent id="_IDGenTileContent1">
                                <ImageContent id="_IDGenImageContent1"
                                    src="sap-icon://employee"/>
                            </TileContent>

                        </GenericTile>


                        <GenericTile
                            id="_IDGenGenericTile2"
                            header="Search Employee"
                            subheader="Find employee"
                            press=".onEmployeesPress"
                            class="actionTile">

                            <TileContent id="_IDGenTileContent2">
                                <ImageContent id="_IDGenImageContent2"
                                    src="sap-icon://search"/>
                            </TileContent>

                        </GenericTile>

                    </HBox>

                </VBox>


                <!-- RECENT EMPLOYEES SECTION -->
                <VBox id="_IDGenVBox2" class="dashboardSection recentEmployeesSection">

                    <Title
                        id="_IDGenTitle4"
                        text="Recent Employees"
                        level="H2"
                        class="sectionTitle"/>

                    <Table
                        id="_IDGenTable"
                        class="employeeTable"
                        items="{
                            path: '/Employees',
                            sorter: {
                                path: 'HireDate',
                                descending: true
                            }
                        }">

                        <columns>

                            <Column id="_IDGenColumn8">
                                <Text id="_IDGenText18" text="Employee"/>
                            </Column>

                            <Column id="_IDGenColumn9">
                                <Text id="_IDGenText19" text="Job Title"/>
                            </Column>

                            <Column id="_IDGenColumn10">
                                <Text id="_IDGenText20" text="Hire Date"/>
                            </Column>

                        </columns>

                        <items>

                            <ColumnListItem id="_IDGenColumnListItem1">

                                <cells>

                                    <ObjectIdentifier id="_IDGenObjectIdentifier1"
                                        title="{FirstName} {LastName}"
                                        text="{EmployeeID}"/>

                                    <Text id="_IDGenText21" text="{Title}"/>

                                    <Text id="_IDGenText22"
                                        text="{
                                            path: 'HireDate',
                                            type: 'sap.ui.model.type.Date',
                                            formatOptions: {
                                                style: 'medium'
                                            }
                                        }"/>

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </VBox>

            </VBox>

        </content>

    </Page>

</mvc:View>